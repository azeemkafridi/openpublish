# ============================================================
# openPublish — environment configuration
#
# Copy to .env and fill in. Only the CORE section is required
# to boot; each platform you want to connect needs its own
# OAuth app credentials (see README.md for per-platform setup).
# ============================================================

# ---- CORE (required) ----
DATABASE_URL=postgres://openpublish:openpublish@localhost:5432/openpublish
REDIS_URL=redis://localhost:6379
# Public URL of this instance. Platforms redirect OAuth callbacks here and
# fetch media from it, so it must be reachable from the internet in production.
BASE_URL=http://localhost:4321
# Session signing secret: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Encrypts platform tokens at rest: openssl rand -hex 32
ENCRYPTION_KEY=

# ---- ENGINE ----
# selfhost (default): publish with your own platform apps + local workers.
# cloud: delegate channels/publishing to the BulkPublish cloud API — no
#        platform app setup needed. Get a key at https://app.bulkpublish.com
ENGINE=selfhost
#BULKPUBLISH_API_URL=https://app.bulkpublish.com
#BULKPUBLISH_API_KEY=bp_...

# ---- MEDIA STORAGE ----
# local (default): files under MEDIA_DIR, served from /uploads.
# s3: any S3-compatible store (R2, S3, MinIO) — set the R2_* vars.
STORAGE=local
MEDIA_DIR=./uploads
# Scratch space for image/video processing. Must NOT be inside MEDIA_DIR.
# Defaults to <system temp>/openpublish.
#MEDIA_TMP_DIR=
#R2_ENDPOINT=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=openpublish
#R2_PUBLIC_URL=

# ---- EMAIL (optional) ----
# Transactional email (verification, reset, failure notifications) via Resend.
# Leave unset to run without email; set REQUIRE_EMAIL_VERIFICATION=true to
# force verified signups once configured.
#RESEND_API_KEY=
#EMAIL_FROM=openPublish <no-reply@example.com>
#EMAIL_REPLY_TO=
#REQUIRE_EMAIL_VERIFICATION=false

# ---- SIGN-IN WITH GOOGLE (optional) ----
#GOOGLE_AUTH_CLIENT_ID=
#GOOGLE_AUTH_CLIENT_SECRET=

# ============================================================
# PLATFORM CREDENTIALS (selfhost engine)
#
# Each platform is enabled by setting PLATFORM_<NAME>=on AND
# providing its credentials. Platforms without credentials are
# hidden from the Connect page automatically.
# OAuth callback URL for most platforms:
#   <BASE_URL>/auth/callback/<platform>
# ============================================================

#PLATFORM_X=on
#X_CLIENT_ID=
#X_CLIENT_SECRET=

#PLATFORM_BLUESKY=on            # app password, no OAuth app needed

#PLATFORM_MASTODON=on           # per-instance app, created automatically

#PLATFORM_LINKEDIN=on
#LINKEDIN_CLIENT_ID=
#LINKEDIN_CLIENT_SECRET=
# Company pages use LinkedIn's separate Community Management API app:
#PLATFORM_LINKEDIN_PAGES=on
#LINKEDIN_PAGES_CLIENT_ID=
#LINKEDIN_PAGES_CLIENT_SECRET=

#PLATFORM_FACEBOOK=on
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=
#FACEBOOK_CONFIG_ID=

#PLATFORM_INSTAGRAM=on
#INSTAGRAM_APP_ID=
#INSTAGRAM_APP_SECRET=

#PLATFORM_THREADS=on
#THREADS_APP_ID=
#THREADS_APP_SECRET=

#PLATFORM_TIKTOK=on
#TIKTOK_CLIENT_KEY=
#TIKTOK_CLIENT_SECRET=

#PLATFORM_YOUTUBE=on
#YOUTUBE_CLIENT_ID=
#YOUTUBE_CLIENT_SECRET=

#PLATFORM_PINTEREST=on
#PINTEREST_APP_ID=
#PINTEREST_APP_SECRET=

#PLATFORM_GMB=on                # Google Business Profile
#GMB_CLIENT_ID=
#GMB_CLIENT_SECRET=

#PLATFORM_REDDIT=on
#REDDIT_CLIENT_ID=
#REDDIT_CLIENT_SECRET=

#PLATFORM_DISCORD=on
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#DISCORD_BOT_TOKEN=

#PLATFORM_TELEGRAM=on           # per-user @BotFather token, no app credentials

#PLATFORM_TUMBLR=on
#TUMBLR_CLIENT_ID=
#TUMBLR_CLIENT_SECRET=

#PLATFORM_SNAPCHAT=on
#SNAPCHAT_CLIENT_ID=
#SNAPCHAT_CLIENT_SECRET=

# ---- TUNING (optional) ----
#DB_POOL_MAX=10
#TRUSTED_PROXY_HOPS=1
#FFMPEG_PATH=
#FFPROBE_PATH=

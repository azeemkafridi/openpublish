{
  "name": "openpublish",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "dev:local": "bash dev.sh",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:baseline": "DRIZZLE_BASELINE=1 node scripts/db-migrate.mjs",
    "db:check-drift": "node scripts/db-check-drift.mjs",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset.ts",
    "start": "node ./server.mjs",
    "worker": "tsx workers/entry.ts",
    "worker:local": "bash worker.sh",
    "worker:prod": "node --import tsx ./workers/entry.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.2",
    "@astrojs/react": "^4.4.2",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@mozilla/readability": "^0.6.0",
    "@scalar/api-reference": "^1.49.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.1",
    "better-auth": "^1.4.18",
    "bullmq": "^5.67.2",
    "compression": "^1.8.1",
    "defuddle": "^0.18.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "express": "^4.22.1",
    "gray-matter": "^4.0.3",
    "image-to-pdf": "^3.0.2",
    "ioredis": "^5.9.2",
    "jsdom": "^28.0.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.34.5",
    "swr": "^2.4.1",
    "tsx": "^4.21.0",
    "undici": "^7.27.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@vitejs/plugin-react": "^5.1.3",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.0.18"
  },
  "license": "AGPL-3.0-only"
}
